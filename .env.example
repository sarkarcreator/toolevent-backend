# Server
NODE_ENV=production
PORT=3001

# Database (currently the app store is in-memory; keep this ready for Prisma migration)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/toolbox_events?schema=public"

# Authentication
JWT_SECRET="change-this-in-production"
JWT_REFRESH_SECRET="change-this-in-production"

# PublicAI (primary AI provider for the Event Planner)
PUBLICAI_API_KEY=""
PUBLICAI_BASE_URL="https://api.publicai.co/v1"
PUBLICAI_MODEL="swiss-ai/apertus-v1.5-8b"

# Gemini (optional fallback)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Payments
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# App
APP_URL="http://localhost:3001"
