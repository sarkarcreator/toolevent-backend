# Server
NODE_ENV=production
PORT=3001

# Hostinger MySQL
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME"

# Authentication
JWT_SECRET="change-this-in-production"
JWT_REFRESH_SECRET="change-this-in-production"
ADMIN_EMAIL="admin@toolbox.events"
ADMIN_PASSWORD="change-this-admin-password"

# PublicAI (primary AI provider)
PUBLICAI_API_KEY=""
PUBLICAI_BASE_URL="https://api.publicai.co/v1"
PUBLICAI_MODEL="swiss-ai/apertus-v1.5-8b"

# Gemini (optional fallback)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Payments
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# App
APP_URL="https://api.toolbox.events"
